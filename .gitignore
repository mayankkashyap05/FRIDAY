# Electron renderer — dependencies and build output are never committed
ui/app/node_modules/
ui/app/dist/
ui/app/*.tsbuildinfo
ui/app/.vite/

# Local runtime state
data/
# Persistent Chrome/Edge profile for YouTube (cookies/cache) — never commit.
data/youtube_profile/
documents/
out/
build/
dist/

# Secrets — never commit API keys
config/*.json
!config/*.example.json

# IDE
.idea/
.vscode/
*.swp

# OS
Thumbs.db
.DS_Store


