# Default local/private mode
FRIDAY_LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:1b-instruct-q2_K
FRIDAY_ENABLE_HAND_VOLUME=false
FRIDAY_INPUT_MODE=voice
FRIDAY_SPEAK_RESPONSES=true
FRIDAY_MINIMIZE_TO_TRAY=true
FRIDAY_WHISPER_MODEL=base
FRIDAY_WORK_APPS=terminal,spotify

# Optional OpenAI Assistants mode
OPENAI_API_KEY=
OPENAI_ASSISTANT_ID=
OPENAI_THREAD_ID=

# Optional integrations
PORCUPINE_API_KEY=
SERPAPI_API_KEY=
ELEVENLABS_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback
FRIDAY_PHONE_NUMBER=
FRIDAY_PHONE_PROVIDER=
FRIDAY_SENDER_EMAIL=
FRIDAY_SENDER_PASSWORD=
